# Clinisight Environment Configuration

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/clinisight

# AI/ML Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Video Processing Configuration
RTSP_URL_ROOM_101=rtsp://your_camera_url_here
RTSP_URL_ROOM_102=rtsp://your_camera_url_here

# Alert Configuration
ALERT_COOLDOWN_SECONDS=5
AI_ANALYSIS_INTERVAL=3

# Logging Configuration
LOG_LEVEL=INFO